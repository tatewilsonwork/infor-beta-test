{
  "$defs": {
    "InvestmentHighlight": {
      "additionalProperties": false,
      "description": "One numbered quadrant on the Key Investment Highlights slide.",
      "properties": {
        "bullets": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Bullets",
          "type": "array"
        },
        "header": {
          "maxLength": 90,
          "minLength": 1,
          "title": "Header",
          "type": "string"
        }
      },
      "required": [
        "header",
        "bullets"
      ],
      "title": "InvestmentHighlight",
      "type": "object"
    },
    "MarketEntryTarget": {
      "additionalProperties": false,
      "description": "One target column on the Potential Market Entry Targets slide.\n\n`name` is the target company's name, used to label its deferred logo box as\n`[<name> Logo]`. `cells` are positional values aligned 1:1 with the fixed\n12-row `market_entry_row_labels` (Overview / HQ / Year Founded \u2192 7 industry\nmetrics \u2192 Scale KPIs / Strategic Rationale).",
      "properties": {
        "cells": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Cells",
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional target company name. Labels the deferred logo box as '[<name> Logo]' (e.g. '[Kueski Logo]'); falls back to the generic '[Company Name Logo]' when absent.",
          "title": "Name"
        }
      },
      "required": [
        "cells"
      ],
      "title": "MarketEntryTarget",
      "type": "object"
    },
    "PitchBullet": {
      "additionalProperties": false,
      "description": "Flexible bullet item used by the deck-content POC.",
      "properties": {
        "level": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "maxLength": 220,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PitchBullet",
      "type": "object"
    },
    "PitchSourceNote": {
      "additionalProperties": false,
      "description": "Source note for analyst-auditable citations.",
      "properties": {
        "citation": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "section": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        }
      },
      "required": [
        "section",
        "citation"
      ],
      "title": "PitchSourceNote",
      "type": "object"
    },
    "RiskMitigantRow": {
      "additionalProperties": false,
      "description": "One acquirer risk with exactly three concise mitigants.",
      "properties": {
        "mitigants": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Mitigants",
          "type": "array"
        },
        "risk": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "risk",
        "mitigants"
      ],
      "title": "RiskMitigantRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Single broad typed content bundle for the slide-library POC deck.",
  "properties": {
    "client_name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Client Name",
      "type": "string"
    },
    "company_overview_bullets": {
      "items": {
        "$ref": "#/$defs/PitchBullet"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Company Overview Bullets",
      "type": "array"
    },
    "comps_takeaway": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Comps Takeaway",
      "type": "string"
    },
    "current_section": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Current Section",
      "type": "string"
    },
    "executive_summary_bullets": {
      "items": {
        "$ref": "#/$defs/PitchBullet"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Executive Summary Bullets",
      "type": "array"
    },
    "financial_metric_labels": {
      "description": "Exactly four financial-summary tile labels \u2014 metric NAMES ONLY (e.g. 'Revenue', 'Adjusted EBITDA', 'Combined Loan Balances', 'Adjusted Return on Equity'). No amounts, currency/percent tokens, colons, periods, or YoY deltas: the (placeholder) charts show the values.",
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Financial Metric Labels",
      "type": "array"
    },
    "investment_highlights": {
      "items": {
        "$ref": "#/$defs/InvestmentHighlight"
      },
      "maxItems": 4,
      "title": "Investment Highlights",
      "type": "array"
    },
    "investment_highlights_tagline": {
      "anyOf": [
        {
          "maxLength": 240,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Investment Highlights Tagline"
    },
    "manual_steps": {
      "items": {
        "type": "string"
      },
      "title": "Manual Steps",
      "type": "array"
    },
    "market_entry_market": {
      "anyOf": [
        {
          "maxLength": 60,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Entry Market"
    },
    "market_entry_row_labels": {
      "description": "The fixed 12-row comparison labels, in order: 'Overview', 'Headquarters', 'Year Founded', then exactly seven industry-relevant metric labels (chosen once for the deck and identical across every target slide), then 'Scale KPIs', 'Strategic Rationale'. Required whenever market_entry_targets is non-empty.",
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Market Entry Row Labels",
      "type": "array"
    },
    "market_entry_targets": {
      "description": "Up to eight target companies. The deck lays them out two per slide (ceil(N/2) market-entry slides), each target's cells aligning 1:1 with the 12 market_entry_row_labels.",
      "items": {
        "$ref": "#/$defs/MarketEntryTarget"
      },
      "maxItems": 8,
      "title": "Market Entry Targets",
      "type": "array"
    },
    "presentation_date": {
      "description": "Fully spelled-out month plus four-digit year, e.g. 'April 2026'.",
      "title": "Presentation Date",
      "type": "string"
    },
    "risk_mitigants": {
      "items": {
        "$ref": "#/$defs/RiskMitigantRow"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Risk Mitigants",
      "type": "array"
    },
    "risks_tagline": {
      "maxLength": 180,
      "minLength": 1,
      "title": "Risks Tagline",
      "type": "string"
    },
    "section_labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Section Labels",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/PitchSourceNote"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "client_name",
    "presentation_date",
    "executive_summary_bullets",
    "section_labels",
    "current_section",
    "company_overview_bullets",
    "financial_metric_labels",
    "risk_mitigants",
    "risks_tagline",
    "comps_takeaway"
  ],
  "title": "PitchDeckContent",
  "type": "object"
}
